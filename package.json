{
  "name": "fish-dock-plugin-rayburst",
  "version": "1.1.0",
  "description": "Standalone Rayburst download manager plugin for FISH-Dock with bundled Aria2 Next",
  "author": "says693",
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "files": [
    "plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "backend.mjs",
    "rayburst-service.mjs",
    "bundled-engine.mjs",
    "page.html",
    "page.css",
    "page.js",
    "page-utils.js",
    "sdk/",
    "vendor/aria2-next.exe",
    "vendor/aria2-next-licenses.txt"
  ],
  "scripts": {
    "check": "node --check backend.mjs && node --check rayburst-service.mjs && node --check bundled-engine.mjs && node --check page.js && node --check page-utils.js && node --check scripts/prepare-engine.mjs && node --check scripts/build.mjs && node --check scripts/verify-package.mjs && node --check scripts/assert-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "vendor:engine": "node scripts/prepare-engine.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run vendor:engine && npm run build",
    "verify": "node scripts/verify-package.mjs",
    "release:check": "node scripts/assert-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/says693/fish-dock-plugin-rayburst.git"
  },
  "bugs": {
    "url": "https://github.com/says693/fish-dock-plugin-rayburst/issues"
  },
  "homepage": "https://github.com/says693/fish-dock-plugin-rayburst#readme",
  "keywords": [
    "fish-dock",
    "fishdock",
    "rayburst",
    "download-manager",
    "aria2",
    "plugin",
    "windows"
  ],
  "devDependencies": {
    "fflate": "^0.8.2",
    "jsdom": "^31.0.1"
  },
  "license": "MIT"
}
