{
  "name": "fish-dock-plugin-rayburst",
  "version": "1.0.1",
  "description": "Rayburst download manager plugin for FISH-Dock",
  "author": "says693",
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "backend.mjs",
    "rayburst-service.mjs",
    "page.html",
    "page.css",
    "page.js",
    "page-utils.js",
    "sdk/"
  ],
  "scripts": {
    "check": "node --check backend.mjs && node --check rayburst-service.mjs && node --check page.js && node --check page-utils.js && node --check scripts/build.mjs && node --check scripts/verify-package.mjs && node --check scripts/assert-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-package.mjs",
    "release:check": "node scripts/assert-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/says693/fish-dock-plugin-rayburst.git"
  },
  "bugs": {
    "url": "https://github.com/says693/fish-dock-plugin-rayburst/issues"
  },
  "homepage": "https://github.com/says693/fish-dock-plugin-rayburst#readme",
  "keywords": [
    "fish-dock",
    "fishdock",
    "rayburst",
    "download-manager",
    "aria2",
    "plugin",
    "windows"
  ],
  "devDependencies": {
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0"
  },
  "license": "MIT"
}
